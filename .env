# Valeurs par défaut (versionnées). Surcharges locales dans .env.local (non versionné).
# Ports publiés sur 127.0.0.1 uniquement (WebHID exige localhost ou HTTPS).
DEV_PORT=5173
PROD_PORT=8080
# Chemin de base de l'app : "/" en local, "/colagan-configurator/" pour GitHub Pages
BASE_PATH=/
# Utilisateur des conteneurs (fichiers créés avec les droits de l'hôte) ; 0 en CI
HOST_UID=1000
HOST_GID=1000
